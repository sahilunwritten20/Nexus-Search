# Nexus Search environment configuration.
# Copy to .env and adjust. .env is git-ignored — never commit real values.

# SQLite database file used by the API / CLI (documents, postings, vectors).
NEXUS_DB=nexus_search.db

# Embedding backend for semantic/hybrid search:
#   st:sentence-transformers/all-MiniLM-L6-v2  -> real semantic model (needs sentence-transformers installed + network on first download)
#   hash[:dim]                                 -> deterministic offline embedder (lexical only, NOT semantic)
NEXUS_EMBEDDER=hash:384

# Test-only: set to 1 to run the sentence-transformers-backed test cases locally.
# NEXUS_RUN_MODEL_TESTS=0

# Deployment mode: anything except "dev" (unset counts as production) REFUSES
# to boot the API without NEXUS_API_KEY. Set "dev" only for local development.
NEXUS_ENV=production

# API key required on the write endpoints (POST/DELETE /documents) via the
# X-API-Key header. Unset + NEXUS_ENV != dev = the API will not start.
NEXUS_API_KEY=

# Query-cache TTL (seconds) for /search responses. Writes clear the cache.
# NEXUS_CACHE_TTL=5

# Reads (GET /search, /documents/{id}, /suggest, /related) are OPEN by design
# for embeddable public search. Set to 1 to key-gate reads too (private
# corpora). Still requires NEXUS_API_KEY to be set for the gate to engage.
# NEXUS_REQUIRE_AUTH_FOR_READS=0

# Per-client rate limit for /search and write endpoints (slowapi syntax).
# Keyed by API key when presented, else by client IP. "0" disables.
# NEXUS_RATE_LIMIT=60/minute

# Comma-separated allowed cross-origin browser origins; unset = no CORS
# headers (browsers default-deny).
# NEXUS_CORS_ORIGINS=https://app.example.com

# Tokenizer stemming at INDEX and QUERY time. Change requires
# `python -m nexus_search.core.reindex --db $NEXUS_DB --shadow` afterwards —
# postings built with a different setting don't match queries silently.
# NEXUS_STEMMING=1

# Ingestion (files/code connectors): max bytes per file, default 64 MiB.
# NEXUS_MAX_INGEST_BYTES=67108864

# OCR fallback for image-only PDFs — needs `tesseract` + pytesseract/pdf2image
# installed. Off by default.
# NEXUS_OCR=0

# Crawler: headless-browser (Playwright/Chromium) rendering of JS-heavy
# pages, P1-7 SSRF-hardened opt-in. Every subrequest is validated against
# the same SSRF rules as plain fetches (private IPs/redirects blocked),
# the final URL is re-validated, and the path stays OFF unless this flag
# is set. Residual risk (documented in crawler/fetcher.py): Chromium
# resolves DNS itself, so DNS-rebinding cannot be pinned away — enable
# only for crawls of trusted hosts. Requires playwright installed.
# NEXUS_RENDER_JS=0

# Spell correction bounds (Phase 5, BUG-01 hardening). A query corrects at
# most 8 terms, only terms up to 20 chars, distance-2 only up to 12 chars,
# under a shared budget of 4000 vocabulary comparisons. On budget
# exhaustion the query runs un-corrected (never an error). Raising these
# makes adversarial queries more expensive — do not without a re-audit.
# NEXUS_SPELL_MAX_TERM_LEN=20
# NEXUS_SPELL_D2_MAX_TERM_LEN=12
# NEXUS_SPELL_MAX_CORRECTED_TERMS=8
# NEXUS_SPELL_CANDIDATE_BUDGET=4000

# Query complexity bounds (BUG-01): a query contributes at most this many
# positive terms to retrieval (extras dropped deterministically), and the
# /search API rejects queries with more than 128 whitespace-separated words
# pre-parse with a 400. Real search queries are far below both.
# NEXUS_MAX_QUERY_TERMS=128

# Hard bound on the fused candidate pool (BUG-03/04). The pool always
# covers offset+top_k and is grown to the full match set so pages of one
# query are stable windows of one ranking. offset+top_k past this bound
# is a 400 — deep-past results are unreachable by contract, never silently.
# NEXUS_MAX_CANDIDATES=1000

# Phase 6 link-intelligence weights (all default 0.0 = inert; single-action
# rollback = set back to 0 + restart, no reindex). Only turn on after the
# eval harness shows uplift (evaluation/authority_benchmark.py).
# NEXUS_AUTHORITY_WEIGHT=0.2
# NEXUS_POPULARITY_WEIGHT=0.1
# NEXUS_ANCHOR_WEIGHT=0.1

# Phase 6 extras:
# NEXUS_DOMAIN_AUTHORITY_FALLBACK=0   # 1: unknown URLs fall back to their domain score
# NEXUS_AUTHORITY_RECOMPUTE_INTERVAL=0 # seconds between background PageRank passes (0=off)

# Reverse-proxy deployments only: N = number of trusted proxy hops; the
# rate limiter then keys on the Nth-from-right X-Forwarded-For entry.
# OFF by default — an untrusted XFF header must never forge a bucket.
# NEXUS_TRUST_PROXY=1

# JSON object overriding any subset of rerank signal weights (clamped [0,1]);
# unknown keys/non-numeric values are logged and ignored, never a boot failure.
# NEXUS_RERANK_WEIGHTS={"title_match":0.3,"freshness":0}

# Click-signal rerank weight: a placeholder slot (no click data exists until
# Phase 7); leave at 0 unless you inject metadata['click_score'] overrides.
# NEXUS_RERANK_WEIGHT_CLICK=0

# A/B query log: rows never expire automatically. Schedule a retention purge
# (e.g. cron) if queries may contain PII:
#   python -c "from nexus_search.ranking.ab import ExperimentLog; \
#              print(ExperimentLog('$NEXUS_DB').purge_older_than(days=30))"
